  },
  "stress_calculations": {
    "arm_bending": {
      "formula": "sigma = (M * c) / I",
      "description": "Bending stress in arm",
      "variables": {
        "M": "Bending moment (thrust * arm_length)",
        "c": "Distance from neutral axis to outer fiber",
        "I": "Second moment of area"
      },
      "safety_factor": 2.5
    },
    "tube_section_properties": {
      "moment_of_inertia": "I = (pi/64) * (D_outer^4 - D_inner^4)",
      "section_modulus": "S = I / (D_outer/2)",
      "area": "A = (pi/4) * (D_outer^2 - D_inner^2)"
    }
  }
}
